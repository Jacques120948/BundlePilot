# Copy to .env for local development. Never commit the real .env file.

# Set automatically by `shopify app dev` / `shopify app deploy` — only needed
# manually when running the server outside the CLI (e.g. `npm run start`).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=write_products,write_discounts,write_cart_transforms

# PostgreSQL connection string for Prisma. See docs/DATABASE.md.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bundlepilot?schema=public
